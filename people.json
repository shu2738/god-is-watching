[{"id": "c01", "name": "셀레스", "race": "인간", "aff": "마법왕국", "role": "대마법사", "attr": "시공(공간) 마법", "grade": "S", "desc": "은발 장발 히메컷, 보라 눈. 남색 마법과 롱코트에 마녀 모자. 도서관에서 책 읽다 고개를 드는 조용한 대마법사.", "male": 0, "emo": ["k", "s", "t", "h", "b", "d", "q", "f"], "reg": "magic"}, {"id": "c02", "name": "로젤리아", "race": "인간", "aff": "마법왕국", "role": "귀족 마법사", "attr": "화염 마법", "grade": "A", "desc": "분홍 드릴 트윈, 붉은 눈. 크림슨 마법과 롱코트. 팔짱 끼고 내려다보는 오만한 귀족 영애.", "male": 0, "emo": ["k", "s", "t", "h", "b", "d", "q", "f"], "reg": "magic"}, {"id": "c03", "name": "라임", "race": "인간", "aff": "마법왕국", "role": "연금술사", "attr": "연금술(산·독)", "grade": "B", "desc": "민트 단발, 동그란 안경, 초록 눈. 흰 마법과 롱코트에 포션병. 호기심 많은 연금술사.", "male": 0, "emo": ["k", "s", "t", "h", "b", "d", "q", "f"], "reg": "magic"}, {"id": "c04", "name": "노엘", "race": "인간", "aff": "마법왕국", "role": "수석 마법사", "attr": "뇌전 마법", "grade": "A", "desc": "흑발 땋은 포니테일, 금안 츠리메. 검은 마법과 롱코트. 차갑고 말수 적은 수석.", "male": 0, "emo": ["k", "s", "t", "h", "b", "d", "q", "f"], "reg": "magic"}, {"id": "c05", "name": "카이엔", "race": "인간", "aff": "마법왕국", "role": "마법사", "attr": "빙결 마법", "grade": "B", "desc": "금발 부스스한 머리, 파란 눈. 하늘색 마법과 롱코트. 손 흔들며 먼저 인사하는 다정한 남자 마법사.", "male": 1, "emo": ["k", "s", "t", "h", "d", "q", "f"], "reg": "magic"}, {"id": "c06", "name": "스칼렛", "race": "인간", "aff": "기사왕국", "role": "기사단장", "attr": "화염 검술", "grade": "S", "desc": "붉은 하이 포니테일, 초록 눈. 남색 기사단 제복에 금 견장, 망토. 자신만만한 기사단장.", "male": 0, "emo": ["k", "s", "t", "h", "b", "d", "q", "f"], "reg": "knight"}, {"id": "c07", "name": "아델", "race": "인간", "aff": "기사왕국", "role": "기사", "attr": "바람 검술", "grade": "B", "desc": "금발 픽시컷, 파란 눈. 흰 기사 제복에 붉은 띠, 레이피어. 경례하는 원칙주의자.", "male": 0, "emo": ["k", "s", "t", "h", "b", "d", "q", "f"], "reg": "knight"}, {"id": "c08", "name": "마고", "race": "인간", "aff": "기사왕국", "role": "견습 기사", "attr": "대지 방패술", "grade": "C", "desc": "갈색 웨이브, 주근깨. 짙은 초록 기사단 제복. 사과 들고 손 흔드는 밝은 막내.", "male": 0, "emo": ["k", "s", "t", "h", "b", "d", "q", "f"], "reg": "knight"}, {"id": "c09", "name": "이리스", "race": "인간", "aff": "기사왕국", "role": "참모", "attr": "그림자 전술", "grade": "A", "desc": "남색 사이드 브레이드, 회색 눈, 안대. 검은 장교 제복에 코트를 어깨에 걸침. 서류 앞의 냉정한 참모.", "male": 0, "emo": ["k", "s", "t", "h", "b", "d", "q", "f"], "reg": "knight"}, {"id": "c11", "name": "엘레나", "race": "인간", "aff": "신성국", "role": "성녀", "attr": "신성 마법", "grade": "S", "desc": "백금발 웨이브 장발, 하늘색 눈. 흰색과 금색의 성녀 로브, 긴 베일. 기도하는 성녀.", "male": 0, "emo": ["k", "s", "t", "h", "b", "d", "q", "f"], "reg": "holy"}, {"id": "c13", "name": "애니", "race": "인간", "aff": "신성국", "role": "시스터", "attr": "치유 마법", "grade": "D", "desc": "주황 짧은 트윈테일, 주근깨. 흰색과 파란색 수녀복에 앞치마. 빵 바구니 든 명랑한 시스터.", "male": 0, "emo": ["k", "s", "t", "h", "b", "d", "q", "f"], "reg": "holy"}, {"id": "c15", "name": "루시안", "race": "인간", "aff": "신성국", "role": "신부", "attr": "정화·봉인", "grade": "B", "desc": "백발 단발, 실눈, 금안. 검은 캐속에 흰 영대. 온화한 남자 신부.", "male": 1, "emo": ["k", "s", "t", "h", "d", "q", "f"], "reg": "holy"}, {"id": "c16", "name": "리나", "race": "인간", "aff": "모험가", "role": "검사", "attr": "바람 검술", "grade": "C", "desc": "갈색 짧은 포니테일. 가죽 갑옷에 빨간 스카프. 엄지 척하는 열혈 검사.", "male": 0, "emo": ["k", "s", "t", "h", "b", "d", "q", "f"], "reg": "adv"}, {"id": "c17", "name": "로빈", "race": "인간", "aff": "모험가", "role": "궁수", "attr": "바람 궁술", "grade": "B", "desc": "초록 땋은 머리, 초록 눈. 후드 망토에 장궁. 나뭇가지에 앉아 내려다보는 궁수.", "male": 0, "emo": ["k", "s", "t", "h", "b", "d", "q", "f"], "reg": "adv"}, {"id": "c20", "name": "레온", "race": "인간", "aff": "모험가", "role": "전사", "attr": "대지 파괴", "grade": "B", "desc": "빨간 삐죽머리, 붉은 눈. 짝짝이 갑옷, 털 망토, 대형 도끼. 길드의 허세 많은 남자 전사.", "male": 1, "emo": ["k", "s", "t", "h", "d", "q", "f"], "reg": "adv"}, {"id": "c21", "name": "이그니", "race": "용족", "aff": "화룡 화산", "role": "화룡", "attr": "용염(불)", "grade": "S", "desc": "붉은 웨이브 장발, 금안 세로동공, 용뿔과 꼬리. 붉은색과 금색 치파오풍 드레스. 보물 위 오만한 화룡.", "male": 0, "emo": ["k", "s", "t", "h", "b", "d", "q", "f"], "reg": "fire"}, {"id": "c22", "name": "시엘", "race": "용족", "aff": "빙룡 설원", "role": "빙룡", "attr": "빙결 용술", "grade": "S", "desc": "은발 히메컷, 하늘색 눈, 흰 뿔. 흰색과 파